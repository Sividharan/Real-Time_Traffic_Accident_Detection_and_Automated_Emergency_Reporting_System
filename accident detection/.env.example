# ============================================================
# Environment Configuration
# Real-Time Traffic Accident Detection & Emergency Reporting
# ============================================================

# ---- Authentication ----
# Secret key for JWT token signing (CHANGE IN PRODUCTION)
JWT_SECRET_KEY=change-this-to-a-secure-random-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

# ---- Traffic Congestion Settings ----
CONGESTION_VEHICLE_THRESHOLD=5

# ---- RTSP Camera Configuration ----
# Comma-separated camera sources (use 'synthetic' for demo mode)
# Examples: rtsp://admin:pass@192.168.1.100:554/stream1, /path/to/video.mp4
CAMERA_SOURCE=synthetic

# ---- External Routing API ----
# Leave empty to use built-in advisory fallback route generator
ROUTING_API_URL=
ROUTING_API_KEY=

# ---- Emergency Dispatch Integration ----
# Leave empty to run with simulated dispatch mode
EMERGENCY_DISPATCH_API_URL=
EMERGENCY_DISPATCH_API_KEY=

# ---- YOLO Model Configuration ----
# Path to YOLO model weights file
YOLO_MODEL_PATH=yolov8n.pt

# ---- Incident Storage & Upload Settings ----
MAX_UPLOAD_SIZE_BYTES=5242880
INCIDENTS_DB_PATH=
INCIDENT_UPLOADS_DIR=

# ---- External Webhook for Hospital Notifications ----
# Leave empty to use simulated notification mode
HOSPITAL_NOTIFICATION_WEBHOOK_URL=
