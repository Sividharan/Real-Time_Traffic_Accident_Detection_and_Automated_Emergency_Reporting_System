# Environment Configuration for Traffic Accident & Congestion Alert System

# Traffic Congestion Settings
CONGESTION_VEHICLE_THRESHOLD=5

# Optional External Routing API Settings
# Leave ROUTING_API_URL empty to use the built-in advisory fallback route generator
ROUTING_API_URL=
ROUTING_API_KEY=

# Authentication Secret
JWT_SECRET_KEY=traffic-system-super-secret-key

# Emergency Dispatch Integration Settings (SCRUM-35)
# Leave empty to run with unconfigured dispatch advisory
EMERGENCY_DISPATCH_API_URL=
EMERGENCY_DISPATCH_API_KEY=

# Incident Storage & Upload Settings (SCRUM-35)
MAX_UPLOAD_SIZE_BYTES=5242880
INCIDENTS_DB_PATH=
INCIDENT_UPLOADS_DIR=
