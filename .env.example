# ============================================================
# Environment Configuration
# Real-Time Traffic Accident Detection & Emergency Reporting
# ============================================================

# ---- Authentication ----
JWT_SECRET_KEY=change-this-to-a-secure-random-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8

# ---- Traffic Congestion Settings ----
CONGESTION_VEHICLE_THRESHOLD=5

# ---- Camera Configuration ----
CAMERA_SOURCE=synthetic

# ---- External APIs (leave empty for simulation mode) ----
ROUTING_API_URL=
ROUTING_API_KEY=
EMERGENCY_DISPATCH_API_URL=
EMERGENCY_DISPATCH_API_KEY=

# ---- YOLO Model ----
YOLO_MODEL_PATH=yolov8n.pt

# ---- Storage ----
MAX_UPLOAD_SIZE_BYTES=5242880
INCIDENTS_DB_PATH=
INCIDENT_UPLOADS_DIR=
HOSPITAL_NOTIFICATION_WEBHOOK_URL=
